# ── LLM Provider ──────────────────────────────────────────────────────────────
# "ollama"  → free, local, PII-safe (default)
# "openai"  → paid cloud fallback
LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# OpenAI (only read when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# ── MCP Server ────────────────────────────────────────────────────────────────
# Absolute path to mcp-statute-server/server.py
MCP_SERVER_PATH=../mcp-statute-server/server.py

# ── Settlement ────────────────────────────────────────────────────────────────
SETTLEMENT_SECRET_KEY=change-me-in-production
SETTLEMENT_BASE_URL=http://localhost:3000/settlement

# ── Storage ───────────────────────────────────────────────────────────────────
DATA_DIR=./data
PDF_DIR=./data/pdfs
